# Copy this file to .env and fill in the values (.env is never committed).
# All variables are server-side only; they are checked at start-up in src/env.ts.

# Directus API, as reached from the SvelteKit server
DIRECTUS_URL=http://127.0.0.1:8055

# Static token of the "Website Bot" user (role "Website", read-only policy "Website Read");
# at least 20 characters
DIRECTUS_TOKEN=

# Base URL the visitor's browser uses for images (/assets/<id>); also allowed in the
# Content-Security-Policy img-src
ASSETS_BASE_URL=http://localhost:8055

# Shared secret of the Directus Flow "Revalidate website" (header x-revalidate-secret);
# at least 32 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=
